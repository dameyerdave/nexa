############
# ALL stack configuration lives here.
#
# 1. Copy this file to .env
# 2. Generate secrets:  sh scripts/generate-keys.sh --update-env
# 3. Create the admin's Metabase account and editor group (see README.md
#    "Authentication") and fill in METABASE_ADMIN_EMAIL/PASSWORD below
# 4. docker compose up -d
#
# YOU MUST CHANGE ALL THE DEFAULT SECRET VALUES BELOW BEFORE STARTING
# THE CONTAINERS FOR THE FIRST TIME.
############


############
# Portal - Nuxt app: Metabase-backed login + portal 2FA, Metabase dashboards
# and Supabase Studio embedded, Excel import
############

# Shown in the portal UI. Keep this generic - it is deliberately what end
# users see instead of "Supabase".
APP_NAME=Nexdata

# Port the portal is published on.
PORTAL_PORT=3100


############
# Postgres
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
# Default configuration includes Supavisor exposing POSTGRES_PORT
POSTGRES_PORT=5432
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password


############
# Secrets - generate with: sh scripts/generate-keys.sh --update-env
############

# Legacy symmetric HS256 key used to sign/verify all Supabase JWTs.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Legacy API keys (HS256-signed JWTs), derived from JWT_SECRET.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Opaque API keys (new-style). Optional - leave blank to use the legacy keys
# above only.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# HTTP Basic Auth in front of the Supabase Studio dashboard (Kong "/"
# route). Studio has no built-in SSO of its own for self-hosted
# deployments, so it stays behind these credentials, which the portal
# embeds into the iframe URL server-side (see
# portal/server/api/studio-link.get.ts) so signed-in users aren't prompted
# for them separately.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# (Must be at least 64 characters; generate with: openssl rand -base64 48)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
# (Must be exactly 16 characters; generate with: openssl rand -hex 8)
REALTIME_DB_ENC_KEY=supabaserealtime
# (Must be exactly 32 characters; generate with: openssl rand -hex 16)
VAULT_ENC_KEY=your-32-character-encryption-key
# (Must be at least 32 characters; generate with: openssl rand -base64 24)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# S3-protocol endpoint credentials for Storage.
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############
# URLs - update these to your real domain(s) in production
############

# Public URL for the Supabase API and Studio (both are served from this one
# origin by Kong - see volumes/api/kong.yml). The portal embeds Studio from
# here in an iframe (editors only) and talks to the API from here too.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Supabase Auth (GoTrue) is still part of the stack - Studio's own project
# settings expect it - but the portal no longer uses it for sign-in;
# Metabase is the identity provider now (see README.md "Authentication").
# These two are just GoTrue's own defaults.
SITE_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

DISABLE_SIGNUP=true

# Public URL for Metabase - Kong's *dedicated* listener for it (see
# KONG_METABASE_PORT above), not Metabase's own container port. The portal
# embeds Metabase from here in an iframe once a user is signed in. Direct
# sign-in on this URL is blocked (see kong.yml's "metabase-session-block"
# route) - only the portal's own login page can start a session.
METABASE_PUBLIC_URL=http://localhost:8002

# A Metabase admin account the portal uses server-to-server (never exposed
# to the browser) to look up which group a signed-in user belongs to. Create
# this account in Metabase's own setup wizard on first boot (reachable
# temporarily by publishing metabase's port, or via `docker compose exec`),
# then lock it down like any other admin account.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me-too

# Name of the Metabase group that grants "editor" access in the portal
# (read/write dashboards, plus Supabase Studio and Import Excel). Any user
# not in this group gets read-only Metabase dashboards only. Create the
# group in Metabase under Admin > People > Groups.
METABASE_EDITOR_GROUP=Editors


############
# Kong - API gateway ports
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
# Metabase's dedicated Kong listener - see kong.yml's "metabase" /
# "metabase-session-block" routes. Not the same as Metabase's own
# container port; Kong sits in front of it here too.
KONG_METABASE_PORT=8002


############
# Supavisor - Postgres connection pooler
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# Optional, enables the Studio AI Assistant.
OPENAI_API_KEY=


############
# Auth (GoTrue) - Mailer / email sign-up
############

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# Auto-confirms new accounts so email/password sign-up works out of the box
# without SMTP configured. Set to false once real SMTP is in place below,
# so new accounts must confirm their address via email.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Nexdata
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false


############
# Auth (GoTrue) - OAuth / SSO providers
#
# Unused by the portal (Metabase is its identity provider - see
# README.md "Authentication") and left disabled below. These variables
# only matter if you sign into Supabase Auth/Studio directly.
############

GOOGLE_ENABLED=false
# OAuth 2.0 Client ID / Secret from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
# Authorized redirect URI: ${API_EXTERNAL_URL}/callback
#   e.g. http://localhost:8000/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=

# AZURE_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_SECRET=


############
# Storage
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=false


############
# PostgREST
############

# Postgres schemas exposed via the REST API and visible in Studio's table
# editor. Tables created by the portal's Excel import feature land in
# `public`, so they're immediately queryable without touching this.
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true
